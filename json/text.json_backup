{
  "endings": {
    "fail": {
      "texts": [
        "常忆画中仙，相望阴阳天。",
        "终究只是追逐黎明的黄昏。",
        "也许身在远方，心却从未远离。",
        "我颠倒世界，也找不到你的倒影。",
        "你转身离去，只留给我一个唯美的背影。"
      ]
    }
  },
  "levels": {
    "1-0":  { "text": "黑夜如约而至，我只能拾阶而上，寻你于光明。" },
    "1-1":  { "text": "流星带你降临，却被你遮蔽了璀璨。" },
    "1-2":  { "text": "你如诗人，言词洞彻未来。" },
    "1-3":  { "text": "你像学者，拆解世界真实。" },
    "1-4":  { "text": "然而这真实的礼盒，名为潘多拉。" },
    "1-5":  { "text": "黑夜如约而至，只为验证你的预言。" },
    "1-6":  { "text": "本句子待完成" },

    "2-0":  { "text": "人间如故，即使登入高塔，也触不到你的衣袂。" },
    "2-1":  { "text": "我跪伏在智慧前，祈求道路。" },
    "2-2":  { "text": "走过城镇，人群喧嚣着金迷如故。" },
    "2-3":  { "text": "越过山林，千峰默默的层峦依旧。" },
    "2-4":  { "text": "无论天空和大海，如你言说。" },
    "2-5":  { "text": "量子也勾勒不出你的轮廓。" },
    "2-6":  { "text": "元素也重塑不了你的身形。" },
    "2-7":  { "text": "回首去，不觉已俯视人间。" },
    "2-8":  { "text": "世人奉我言语，却不知你的意。" },
    "2-9":  { "text": "繁星上的倒影，提醒着渐行渐远。" },

    "3-0":  { "text": "繁星亿万，也能踏遍，哪管他世界嘲笑。" },
    "3-1":  { "text": "\"两个世界\"我如此道予世间。" },
    "3-2":  { "text": "只叹惊世骇俗，再无回应。" },
    "3-3":  { "text": "不耐，强权或是唯一道路。" },
    "3-4":  { "text": "废墟后的新生，是帝国与秩序。" },
    "3-5":  { "text": "集众生再望彼方，唯星辰大海。" },
    "3-6":  { "text": "星绕炙炎，生万物却无你。" },
    "3-7":  { "text": "又有自灼，润苍生而缺我意" },
    "3-8":  { "text": "纵星海奔腾，也不见真理浪起。" },
    "3-9":  { "text": "大梦数十载，只换来众人嘲笑。" },
    "3-10": { "text": "既已为王，可知何为王？" },

    "4-0":  { "text": "陷入绝望，我背叛一切，想颠倒世界" },
    "4-1":  { "text": "寻寻觅觅，这期许又成空。" },
    "4-2":  { "text": "再向世间重复\"这两个世界\"。" },
    "4-3":  { "text": "石沉大海，如我孤独于世间。" },
    "4-4":  { "text": "心绪渊狱疯涨，绝望蔓延。" },
    "4-5":  { "text": "怀抱禁忌，似疯又如魔。" },
    "4-6":  { "text": "你的状态，我加之于人。" },
    "4-7":  { "text": "一无所获，心坠地狱愈陷深。" },
    "4-8":  { "text": "恶念四起，做狂徒取他族生机。" },
    "4-9":  { "text": "生灵涂炭已成渊，愿犹未能偿。" },
    "4-10": { "text": "千夫所指为暴君，万世之不幸。" },
    "4-11": { "text": "犹自横天，妄定两界因果。" },

    "5-0":  { "text": "终究作茧自缚，失去所有，也回不到有你的位置。" },
    "5-1":  { "text": "众传自负猖狂，不容于人间。" },
    "5-2":  { "text": "即不可为人，也不再为王。" },
    "5-3":  { "text": "失去所有，不论声名荣誉。" },
    "5-4":  { "text": "再被流放，福祸不可知。" },
    "5-5":  { "text": "铁鞋踏破，未想重逢于此。" },
    "5-6":  { "text": "谈论天地，醉入梦幻里" },
    "5-7":  { "text": "好景和良辰，不再疯魔。" },
    "5-8":  { "text": "静思方知她意，笑叹一生" },
    "5-9":  { "text": "魔消再回首，方知人又去。" },
    "5-10": { "text": "重论过往，终知方向。" },
    "5-11": { "text": "拨动时间，再回往昔。" },

    "6-0":  { "text": "无奈化蝶，回到起点，重选前方道路。" },
    "6-1":  { "text": "世间变化，是蝴蝶鼓动的翼。" },
    "6-2":  { "text": "时间流动，是真理的洗礼。" },
    "6-3":  { "text": "现在即存在的证明。" },
    "6-4":  { "text": "未来即存在的意义。" },
    "6-5":  { "text": "终于重回过去，再历抉择。" },
    "6-6":  { "text": "见流星降临，又是璀璨不再。" },
    "6-7":  { "text": "见你笑靥如星辰，似待我归。" },
    "6-8":  { "text": "再论未来与真实，方知你意。" },
    "6-9":  { "text": "前生今世，只诉此相思。" },
    "6-10": { "text": "又论离别，相依相恋相知。" },
    "6-11": { "text": "再忆前生，恍如一梦。" },
    "6-12": { "text": "梦里霸王无别姬，却知去路。" },

    "7-0":  { "text": "重铸世界，没你的路线，终非我所愿。" },
    "7-1":  { "text": "虚空有世界相近，吞没彼此。" },
    "7-2":  { "text": "毁天灭地，万物成灭。" },
    "7-3":  { "text": "有痴人妄救世，不舍其一。" },
    "7-4":  { "text": "有力未逮，南柯一梦。" },
    "7-5":  { "text": "舍其一而存其一，去你所言。" },
    "7-6":  { "text": "机缘因你而起，遵你所愿。" },
    "7-7":  { "text": "存我世界，铭刻你心。" },
    "7-8":  { "text": "再过城镇，喧嚣也亲昵。" },
    "7-9":  { "text": "再越山林，风雨也清新。" },
    "7-10": { "text": "天空大海，为我所向。" },
    "7-11": { "text": "你的真理即是真实，我顺流而下。" },
    "7-12": { "text": "重回人群，再寻真理。" },

    "8-0":  { "text": "新希望的萌芽，或许坎坷，总有一线生机。" },
    "8-1":  { "text": "一晃少年又去，青年又来。" },
    "8-2":  { "text": "登高望远，只是不再俯视人间。" },
    "8-3":  { "text": "集众之力，贯通黑白。" },
    "8-4":  { "text": "虽隔一世界，却有音相随。" },
    "8-5":  { "text": "听你之音，如闻天籁。" },
    "8-6":  { "text": "为何救我的世界。" },
    "8-7":  { "text": "因为那是你的世界。" },
    "8-8":  { "text": "笑音如轻铃，叹世界已衰。" },
    "8-9":  { "text": "无计可施，何不来此世界？" },
    "8-10": { "text": "清音如故\"只可稍作停留\"。" },
    "8-11": { "text": "听你言语，虽清静却悲伤。" },
    "8-12": { "text": "或不可救世界，但愿救一人。" },

    "9-0":  { "text": "当心！当你经过这个陷阱时，空间塌陷会吸引周围四个圆一起翻转。" },
    "9-1":  { "text": "与你论今后，寻外力于星空。" },
    "9-2":  { "text": "纳川河之音，集众生之力。" },
    "9-3":  { "text": "再上征途，越星辰大海。" },
    "9-4":  { "text": "有星炙热如火，生一族而润万物。" },
    "9-5":  { "text": "相逢为友人，识天机了真意。" },
    "9-6":  { "text": "诉世界杀机，引你与相见。" },
    "9-7":  { "text": "论存世之真理，相助于天地动荡间。" },
    "9-8":  { "text": "此去经年，再见不知道何时。" },
    "9-9":  { "text": "见你笑颜如初见，私铭于我心。" },
    "9-10": { "text": "不及道衷肠，又闻已离别。" },
    "9-11": { "text": "此去路无休，救世只为救你依。" },
    "9-12": { "text": "寻众文明于宇宙，一晃数十年" },

    "10-0":  { "text": "万众一心，建利刃斩末日，却又再忆前缘。" },
    "10-1":  { "text": "救世功德，天道有助。" },
    "10-2":  { "text": "集宇宙文明，动一世乾坤。" },
    "10-3":  { "text": "夺天地造化，建利刃斩末日。" },
    "10-4":  { "text": "知未来识天机，定因果合众愿。" },
    "10-5":  { "text": "代行利刃斩世界，心刻有你又动摇。" },
    "10-6":  { "text": "生而为凡俗，不为他人唯我愿。" },
    "10-7":  { "text": "错失良机误众生，罪尤未能赎。" },
    "10-8":  { "text": "久持利刃不见斩，又有非议传。" },
    "10-9":  { "text": "弃剑封笔，大隐归闹市。" },
    "10-10": { "text": "虽觉逍遥，却难断相思苦。" },
    "10-11": { "text": "相恋于天涯，可知终有期。" },
    "10-12": { "text": "终末临，人未至。" },

    "11-0":  { "text": "命运落幕，魂归星海，名垂百年。" },
    "11-1":  { "text": "星河源远，终归于一。" },
    "11-2":  { "text": "曾可主宰大千，对抗天地。" },
    "11-3":  { "text": "俯仰一世，只留传说故事。" },
    "11-4":  { "text": "无可逃避的结局，总会降临。" },
    "11-5":  { "text": "命运之名，其为真实之理。" },
    "11-6":  { "text": "无可辩驳，无可更改，无可反抗。" },
    "11-7":  { "text": "即使大略滔天，也唯有臣服。" },
    "11-8":  { "text": "天地轮回，生生灭灭，不怜众生。" },
    "11-9":  { "text": "为情不忍，为爱留情。" },
    "11-10": { "text": "可见这相遇亦为命运。" },
    "11-11": { "text": "终结于唯有应有时。" },
    "11-12": { "text": "今生虽是确定，未来仍是未知。" }
  }
}